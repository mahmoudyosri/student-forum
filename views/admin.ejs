<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة التحكم الإبداعية | Admin Dashboard</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome للأيقونات -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts (Cairo) -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        cairo: ['Cairo', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f5ff',
                            100: '#e0ebff',
                            500: '#4f46e5',
                            600: '#4338ca',
                            700: '#3730a3',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Cairo', sans-serif; }
        .glass-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(226, 232, 240, 0.8);
        }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col antialiased selection:bg-indigo-500 selection:text-white">

    <!-- شريط التنقل العلوي -->
    <header class="bg-slate-900/80 backdrop-blur-md border-b border-slate-800 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center space-x-4 space-x-reverse">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center shadow-lg shadow-indigo-500/30">
                    <i class="fa-solid fa-shapes text-white text-xl"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold bg-gradient-to-r from-white to-slate-400 bg-clip-text text-transparent">لوحة التحكم المركزية</h1>
                    <p class="text-xs text-slate-400">إدارة النظام، الشكاوى، وشؤون الطلاب بذكاء</p>
                </div>
            </div>
            
            <div class="flex items-center space-x-3 space-x-reverse">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                    <span class="w-2 h-2 mr-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    النظام يعمل بكفاءة
                </span>
                <a href="/logout" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-rose-500/10 hover:text-rose-400 hover:border-rose-500/20 border border-slate-700 transition text-sm font-semibold flex items-center gap-2">
                    <i class="fa-solid fa-power-off"></i> خروج
                </a>
            </div>
        </div>
    </header>

    <!-- المحتوى الرئيسي -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow space-y-8">
        
        <!-- قسم الإحصائيات السريعة -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <div class="bg-slate-800/50 border border-slate-700/60 rounded-2xl p-6 relative overflow-hidden group hover:border-indigo-500/50 transition">
                <div class="absolute -left-4 -bottom-4 w-24 h-24 bg-indigo-500/10 rounded-full blur-xl group-hover:bg-indigo-500/20 transition"></div>
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-400">الطلاب المسجلين</p>
                        <h3 class="text-2xl font-bold text-white mt-1">2,450</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-user-graduate"></i>
                    </div>
                </div>
            </div>

            <div class="bg-slate-800/50 border border-slate-700/60 rounded-2xl p-6 relative overflow-hidden group hover:border-amber-500/50 transition">
                <div class="absolute -left-4 -bottom-4 w-24 h-24 bg-amber-500/10 rounded-full blur-xl group-hover:bg-amber-500/20 transition"></div>
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-400">منشورات بانتظار المراجعة</p>
                        <h3 class="text-2xl font-bold text-white mt-1">12</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                    </div>
                </div>
            </div>

            <div class="bg-slate-800/50 border border-slate-700/60 rounded-2xl p-6 relative overflow-hidden group hover:border-rose-500/50 transition">
                <div class="absolute -left-4 -bottom-4 w-24 h-24 bg-rose-500/10 rounded-full blur-xl group-hover:bg-rose-500/20 transition"></div>
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-400">البلاغات الواردة</p>
                        <h3 class="text-2xl font-bold text-white mt-1">5</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-rose-500/10 text-rose-400 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                </div>
            </div>

            <div class="bg-slate-800/50 border border-slate-700/60 rounded-2xl p-6 relative overflow-hidden group hover:border-emerald-500/50 transition">
                <div class="absolute -left-4 -bottom-4 w-24 h-24 bg-emerald-500/10 rounded-full blur-xl group-hover:bg-emerald-500/20 transition"></div>
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-400">التعليقات المنشورة</p>
                        <h3 class="text-2xl font-bold text-white mt-1">1,280</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-comments"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- قسم التبويبات والمحتوى الرئيسي -->
        <div class="bg-slate-800/40 border border-slate-800 rounded-3xl p-6 backdrop-blur-xl">
            <!-- العنوان الفرعي أو التبويبات -->
            <div class="border-b border-slate-700/60 pb-4 mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <h2 class="text-lg font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-list-check text-indigo-400"></i> إدارة محتوى المنصة والطلاب
                </h2>
                <!-- شريط بحث سريع أو فلاتر -->
                <div class="relative">
                    <span class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-slate-400">
                        <i class="fa-solid fa-search"></i>
                    </span>
                    <input type="text" placeholder="بحث سريع في السجلات..." class="w-full sm:w-64 bg-slate-900 border border-slate-700 rounded-xl pr-10 pl-4 py-2 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 transition">
                </div>
            </div>

            <!-- نموذج مثال لبطاقة محتوى (يمكن ربطها بـ EJS Loops الخاصة بك) -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- بطاقة الشكاوى والبلاغات -->
                <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-5 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-3">
                            <span class="px-3 py-1 rounded-lg text-xs font-semibold bg-rose-500/10 text-rose-400 border border-rose-500/20">بلاغ جديد</span>
                            <span class="text-xs text-slate-500">منذ 10 دقائق</span>
                        </div>
                        <p class="text-sm text-slate-300 leading-relaxed mb-4">هذا النص يمثل محتوى نموذجياً لتعليق أو منشور تم الإبلاغ عنه لمراجعته من قبل الإدارة.</p>
                    </div>
                    <div class="flex items-center gap-2 pt-4 border-t border-slate-800">
                        <button class="flex-1 bg-indigo-600 hover:bg-indigo-500 text-white py-2 rounded-xl text-xs font-semibold transition shadow-lg shadow-indigo-600/20">تجاهل البلاغ</button>
                        <button class="flex-1 bg-rose-600/10 hover:bg-rose-600 text-rose-400 hover:text-white border border-rose-500/20 py-2 rounded-xl text-xs font-semibold transition">حذف المحتوى</button>
                    </div>
                </div>

                <!-- بطاقة إدارة شؤون الطلاب -->
                <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-5 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-3">
                            <span class="px-3 py-1 rounded-lg text-xs font-semibold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">إضافة بيانات طالب</span>
                            <i class="fa-solid fa-user-plus text-slate-500"></i>
                        </div>
                        <p class="text-sm text-slate-300 mb-4">يمكنك رفع ملف Excel يحتوي على بيانات الدفعة الجديدة أو إضافة طالب فردي بالرقم القومي.</p>
                    </div>
                    <div class="flex items-center gap-2 pt-4 border-t border-slate-800">
                        <button class="w-full bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 py-2 rounded-xl text-xs font-semibold transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-file-excel text-emerald-400"></i> رفع ملف Excel للطلاب
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </main>

    <!-- تذييل الصفحة -->
    <footer class="border-t border-slate-800 bg-slate-900/50 py-6 text-center text-xs text-slate-500">
        <p>جميع الحقوق محفوظة © لوحة التحكم الإدارية المتقدمة</p>
    </footer>

</body>
</html>
