<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ساحة المناقشات | المنصة التعليمية</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #0f172a;
            --primary-light: #1e293b;
            --accent: #2563eb;
            --accent-hover: #1d4ed8;
            --bg: #f8fafc;
            --card-bg: #ffffff;
            --border: #e2e8f0;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --danger: #ef4444;
            --success: #10b981;
            --radius-lg: 20px;
            --radius-md: 12px;
            --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
            --shadow-md: 0 10px 25px -5px rgba(37, 99, 235, 0.05), 0 8px 10px -6px rgba(15, 23, 42, 0.05);
            --transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            box-sizing: border-box;
            font-family: 'Cairo', 'Segoe UI', system-ui, sans-serif;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg);
            color: var(--text-main);
            padding-bottom: 80px;
            min-height: 100vh;
        }

        /* Header */
        header {
            background: rgba(255, 255, 255, 0.9);
            border-bottom: 1px solid var(--border);
            padding: 0.9rem 2.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 4px 20px rgba(0,0,0,0.03);
            backdrop-filter: blur(12px);
        }

        .header-brand {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .header-brand img {
            height: 46px;
            width: auto;
            object-fit: contain;
            border-radius: 8px;
        }

        .header-brand h1 {
            font-size: 1.25rem;
            color: var(--primary);
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .user-nav {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-badge {
            font-size: 0.88rem;
            font-weight: 700;
            color: #1e293b;
            background: #f1f5f9;
            padding: 0.5rem 1.1rem;
            border-radius: 30px;
            border: 1px solid #cbd5e1;
            display: flex;
            align-items: center;
            gap: 8px;
            box-shadow: inset 0 1px 2px rgba(0,0,0,0.02);
        }

        .btn-logout {
            background: #fef2f2;
            color: #dc2626;
            text-decoration: none;
            padding: 0.5rem 1.1rem;
            border-radius: var(--radius-md);
            font-size: 0.88rem;
            font-weight: 700;
            transition: var(--transition);
            border: 1px solid #fee2e2;
        }

        .btn-logout:hover {
            background: #ef4444;
            color: white;
            border-color: #ef4444;
            transform: translateY(-1px);
        }

        .btn-admin-link {
            background: var(--accent);
            color: white;
            text-decoration: none;
            padding: 0.5rem 1.2rem;
            border-radius: var(--radius-md);
            font-size: 0.88rem;
            font-weight: 700;
            transition: var(--transition);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
        }

        .btn-admin-link:hover {
            background: var(--accent-hover);
            transform: translateY(-1px);
            box-shadow: 0 6px 15px rgba(37, 99, 235, 0.3);
        }

        /* Container */
        .container {
            max-width: 760px;
            margin: 2rem auto;
            padding: 0 1.2rem;
        }

        /* Search Bar */
        .search-card {
            background: var(--card-bg);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            padding: 0.9rem 1.2rem;
            margin-bottom: 1.5rem;
            display: flex;
            gap: 12px;
            box-shadow: var(--shadow-sm);
            align-items: center;
            transition: var(--transition);
        }

        .search-card:focus-within {
            border-color: var(--accent);
            box-shadow: var(--shadow-md);
        }

        .search-card input {
            flex: 1;
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            padding: 0.75rem 1.1rem;
            font-size: 0.95rem;
            outline: none;
            transition: var(--transition);
            background: #f8fafc;
        }

        .search-card input:focus {
            border-color: var(--accent);
            background: #fff;
        }

        .search-card button {
            background: var(--primary);
            color: white;
            border: none;
            padding: 0.75rem 1.6rem;
            border-radius: var(--radius-md);
            font-weight: 700;
            cursor: pointer;
            transition: var(--transition);
        }

        .search-card button:hover {
            background: var(--primary-light);
            transform: translateY(-1px);
        }

        /* Post Cards */
        .card {
            background: var(--card-bg);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            box-shadow: var(--shadow-sm);
            transition: var(--transition);
        }

        .card:hover {
            box-shadow: var(--shadow-md);
        }

        .pinned-card {
            border: 2px solid #3b82f6;
            background: linear-gradient(0deg, #f0f9ff 0%, #ffffff 100%);
            box-shadow: 0 10px 25px -5px rgba(59, 130, 246, 0.08);
        }

        /* Create Post Area */
        .create-post-form {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        textarea {
            width: 100%;
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            padding: 1rem;
            font-size: 1rem;
            outline: none;
            resize: vertical;
            min-height: 110px;
            transition: var(--transition);
            background: #f8fafc;
            color: var(--text-main);
        }

        textarea:focus {
            border-color: var(--accent);
            background: #fff;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.08);
        }

        .file-upload {
            font-size: 0.88rem;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 12px;
            background: #f8fafc;
            padding: 0.75rem 1rem;
            border-radius: var(--radius-md);
            border: 1px dashed #cbd5e1;
            flex-wrap: wrap;
            transition: var(--transition);
        }

        .file-upload:hover {
            border-color: var(--accent);
            background: #f1f5f9;
        }

        .file-upload input[type="file"] {
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .btn-post {
            background: var(--accent);
            color: white;
            border: none;
            padding: 0.75rem 1.8rem;
            border-radius: var(--radius-md);
            font-weight: 700;
            cursor: pointer;
            align-self: flex-start;
            transition: var(--transition);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
        }

        .btn-post:hover {
            background: var(--accent-hover);
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(37, 99, 235, 0.3);
        }

        /* Post Header & Meta */
        .post-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid #f1f5f9;
        }

        .author-box {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .author {
            font-weight: 800;
            color: #0f172a;
            font-size: 1.05rem;
        }

        .role-tag {
            font-size: 0.75rem;
            background: #dbeafe;
            color: #1e40af;
            padding: 3px 10px;
            border-radius: 20px;
            font-weight: 700;
        }

        .pin-badge {
            font-size: 0.75rem;
            background: #2563eb;
            color: white;
            padding: 3px 10px;
            border-radius: 8px;
            font-weight: 700;
            box-shadow: 0 2px 5px rgba(37, 99, 235, 0.2);
        }

        .meta-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .date {
            font-size: 0.78rem;
            color: var(--text-muted);
            font-weight: 600;
        }

        /* Like & Action Buttons */
        .post-actions-bar {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-top: 1rem;
            padding-top: 0.75rem;
            border-top: 1px solid #f1f5f9;
        }

        .btn-like {
            background: #f8fafc;
            border: 1px solid var(--border);
            color: var(--text-muted);
            font-size: 0.88rem;
            font-weight: 700;
            padding: 0.4rem 0.9rem;
            border-radius: 20px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: var(--transition);
        }

        .btn-like:hover {
            background: #f1f5f9;
            color: #e11d48;
            border-color: #fecdd3;
        }

        .btn-like.liked {
            background: #fff1f2;
            color: #e11d48;
            border-color: #fecdd3;
        }

        /* Report Button */
        .btn-report {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            color: #64748b;
            font-size: 0.8rem;
            cursor: pointer;
            padding: 4px 10px;
            border-radius: 6px;
            transition: var(--transition);
            font-weight: 600;
        }

        .btn-report:hover {
            color: var(--danger);
            background: #fef2f2;
            border-color: #fecaca;
        }

        /* Post Content */
        .post-body {
            font-size: 1.02rem;
            line-height: 1.8;
            margin-bottom: 1.25rem;
            color: #334155;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .media-preview img {
            max-width: 100%;
            border-radius: var(--radius-md);
            border: 1px solid var(--border);
            margin-top: 0.75rem;
            max-height: 500px;
            object-fit: contain;
            width: 100%;
            background: #0f172a05;
        }

        .pdf-box {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: #fef2f2;
            color: #991b1b;
            padding: 0.75rem 1.4rem;
            border-radius: var(--radius-md);
            text-decoration: none;
            font-weight: 700;
            font-size: 0.9rem;
            border: 1px solid #fecaca;
            transition: var(--transition);
            margin-top: 0.75rem;
            box-shadow: 0 2px 5px rgba(239, 68, 68, 0.05);
        }

        .pdf-box:hover {
            background: #fee2e2;
            transform: translateY(-1px);
        }

        /* Comments Section */
        .comments {
            background: #f8fafc;
            border-radius: var(--radius-md);
            padding: 1.1rem;
            margin-top: 1.25rem;
            border: 1px solid #e2e8f0;
        }

        .comment-item {
            font-size: 0.9rem;
            padding: 0.75rem 0;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 10px;
        }

        .comment-item:last-child {
            border-bottom: none;
        }

        .comment-content {
            flex: 1;
            word-break: break-word;
            line-height: 1.6;
            color: #334155;
        }

        .comment-footer {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-top: 4px;
        }

        .comment-form {
            display: flex;
            gap: 10px;
            margin-top: 1rem;
        }

        .comment-form input {
            flex: 1;
            padding: 0.7rem 1rem;
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            font-size: 0.88rem;
            outline: none;
            background: #ffffff;
            transition: var(--transition);
        }

        .comment-form input:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
        }

        .comment-form button {
            background: #0284c7;
            color: white;
            border: none;
            padding: 0.7rem 1.3rem;
            border-radius: var(--radius-md);
            font-size: 0.88rem;
            font-weight: 700;
            cursor: pointer;
            transition: var(--transition);
        }

        .comment-form button:hover {
            background: #0369a1;
            transform: translateY(-1px);
        }

        /* Modal / Dialog for Reporting */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(15, 23, 42, 0.65);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            backdrop-filter: blur(6px);
            animation: fadeIn 0.2s ease-in-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .modal-box {
            background: white;
            border-radius: var(--radius-lg);
            padding: 1.75rem;
            width: 90%;
            max-width: 460px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            animation: scaleUp 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes scaleUp {
            from { transform: scale(0.95); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }

        .modal-box h3 {
            font-size: 1.2rem;
            margin-bottom: 0.5rem;
            color: var(--primary);
            font-weight: 800;
        }

        .modal-box textarea {
            min-height: 95px;
            margin-bottom: 1.2rem;
            background: #f8fafc;
        }

        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .btn-cancel {
            background: #e2e8f0;
            color: #475569;
            border: none;
            padding: 0.6rem 1.2rem;
            border-radius: var(--radius-md);
            font-weight: 700;
            cursor: pointer;
            transition: var(--transition);
        }

        .btn-cancel:hover {
            background: #cbd5e1;
        }

        .btn-submit-report {
            background: var(--danger);
            color: white;
            border: none;
            padding: 0.6rem 1.4rem;
            border-radius: var(--radius-md);
            font-weight: 700;
            cursor: pointer;
            transition: var(--transition);
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2);
        }

        .btn-submit-report:hover {
            background: #dc2626;
            transform: translateY(-1px);
        }
    </style>
</head>
<body>

    <header>
        <div class="header-brand">
            <img src="/logo.png" alt="شعار المعهد" onerror="this.style.display='none'">
            <h1>منصة المناقشات</h1>
        </div>
        <div class="user-nav">
            <span class="user-badge">👤 <%= user.display_name %></span>
            <% if(user.role === 'admin') { %>
                <a href="/admin" class="btn-admin-link">🛠️ لوحة التحكم</a>
            <% } %>
            <a href="/logout" class="btn-logout">خروج</a>
        </div>
    </header>

    <div class="container">
        <!-- البحث في المناقشات -->
        <form action="/" method="GET" class="search-card">
            <input type="text" name="search" value="<%= search %>" placeholder="🔍 بحث بكلمة مفتاحية أو باسم الطالب...">
            <button type="submit">بحث</button>
            <% if(search) { %>
                <a href="/" style="align-self: center; font-size: 0.88rem; color: var(--danger); text-decoration: none; font-weight: 700; padding: 0.5rem;">إلغاء</a>
            <% } %>
        </form>

        <!-- إنشاء منشور جديد (AJAX) -->
        <div class="card">
            <form id="createPostForm" action="/posts" method="POST" enctype="multipart/form-data" class="create-post-form">
                <textarea name="content" placeholder="طرح سؤال، استفسار، أو موضوع جديد للطلاب..."></textarea>
                <div class="file-upload">
                    <span>📎 إرفاق ملف PDF أو صورة:</span> 
                    <input type="file" name="attachment" accept="image/*,application/pdf">
                </div>
                <button type="submit" class="btn-post">نشر الموضوع</button>
            </form>
        </div>

        <!-- تغذية المنشورات -->
        <div id="postsContainer">
            <% if(posts.length === 0) { %>
                <div id="noPostsMsg" class="card" style="text-align: center; color: var(--text-muted); padding: 2.5rem; font-weight: 600;">
                    لا توجد منشورات متاحة حالياً.
                </div>
            <% } %>

            <% posts.forEach(post => { %>
                <div class="card <%= post.is_pinned ? 'pinned-card' : '' %>" data-post-id="<%= post.id %>">
                    <div class="post-meta">
                        <div class="author-box">
                            <span class="author"><%= post.display_name %></span>
                            <% if(post.role === 'admin') { %><span class="role-tag">إدارة المعهد</span><% } %>
                            <% if(post.is_pinned) { %><span class="pin-badge">📌 مثبت</span><% } %>
                        </div>
                        <div class="meta-left">
                            <span class="date">
                                <%= new Date(post.created_at).toLocaleString('ar-EG', { timeZone: 'Africa/Cairo', dateStyle: 'short', timeStyle: 'short' }) %>
                            </span>
                            <button class="btn-report" onclick="openReportModal('post', <%= post.id %>)" title="إبلاغ عن المحتوى">🚨 إبلاغ</button>
                        </div>
                    </div>

                    <% if(post.content) { %>
                        <div class="post-body"><%= post.content %></div>
                    <% } %>

                    <% if(post.file_path) { %>
                        <div class="media-preview">
                            <% if(post.media_status === 'pending') { %>
                                <div style="background: #fffbeb; color: #b45309; padding: 0.85rem; border-radius: 10px; font-size: 0.88rem; border: 1px dashed #fcd34d; font-weight: 600;">
                                    ⏳ الصورة قيد مراجعة الإدارة وسوف تظهر للجميع فور اعتمادها.
                                </div>
                            <% } else if(post.file_type === 'image') { %>
                                <img src="<%= post.file_path %>" alt="صورة مرفقة" loading="lazy">
                            <% } else if(post.file_type === 'pdf') { %>
                                <a href="<%= post.file_path %>" target="_blank" class="pdf-box">📄 فتح ملف PDF المرفق</a>
                            <% } %>
                        </div>
                    <% } %>

                    <!-- أزرار التفاعل والإعجاب للبوست -->
                    <div class="post-actions-bar">
                        <button class="btn-like <%= post.is_liked ? 'liked' : '' %>" onclick="toggleLike('post', <%= post.id %>, this)">
                            ❤️ <span class="like-count"><%= post.likes_count %></span> إعجاب
                        </button>
                    </div>

                    <!-- التعليقات -->
                    <div class="comments">
                        <div class="comments-list">
                            <% post.comments.forEach(comment => { %>
                                <div class="comment-item" data-comment-id="<%= comment.id %>">
                                    <div class="comment-content">
                                        <b><%= comment.display_name %>:</b> <%= comment.content %>
                                        <div class="comment-footer">
                                            <span style="font-size: 0.72rem; color: #94a3b8; font-weight: 600;">
                                                (<%= new Date(comment.created_at).toLocaleString('ar-EG', { timeZone: 'Africa/Cairo', timeStyle: 'short' }) %>)
                                            </span>
                                            <button class="btn-like <%= comment.is_liked ? 'liked' : '' %>" style="font-size:0.75rem; padding:2px 6px;" onclick="toggleLike('comment', <%= comment.id %>, this)">
                                                ❤️ <span class="like-count"><%= comment.likes_count %></span>
                                            </button>
                                        </div>
                                    </div>
                                    <button class="btn-report" onclick="openReportModal('comment', <%= comment.id %>)" title="إبلاغ عن التعليق">🚨 إبلاغ</button>
                                </div>
                            <% }) %>
                        </div>

                        <form class="comment-form" onsubmit="submitComment(event, <%= post.id %>)">
                            <input type="text" name="content" placeholder="اكتب تعليقاً..." required>
                            <button type="submit">تعليق</button>
                        </form>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <!-- نافذة الإبلاغ (Modal) -->
    <div id="reportModal" class="modal-overlay">
        <div class="modal-box">
            <h3>🚨 إبلاغ عن محتوى غير لائق</h3>
            <p style="font-size: 0.88rem; color: var(--text-muted); margin-bottom: 1rem; font-weight: 600;">
                يرجى توضيح سبب الإبلاغ ليتم مراجعته فوراً من قبل الإدارة.
            </p>
            <textarea id="reportReason" placeholder="اكتب سبب الإبلاغ هنا..."></textarea>
            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="closeReportModal()">إلغاء</button>
                <button type="button" class="btn-submit-report" onclick="submitReport()">إرسال البلاغ</button>
            </div>
        </div>
    </div>

    <script>
        let currentTargetType = null;
        let currentTargetId = null;

        function openReportModal(type, id) {
            currentTargetType = type;
            currentTargetId = id;
            document.getElementById('reportReason').value = '';
            document.getElementById('reportModal').style.display = 'flex';
        }

        function closeReportModal() {
            document.getElementById('reportModal').style.display = 'none';
            currentTargetType = null;
            currentTargetId = null;
        }

        async function submitReport() {
            const reason = document.getElementById('reportReason').value.trim();
            if (!reason) {
                alert('يرجى كتابة سبب الإبلاغ.');
                return;
            }

            try {
                const response = await fetch('/report', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        target_type: currentTargetType,
                        target_id: currentTargetId,
                        reason: reason
                    })
                });

                const data = await response.json();
                if (data.success) {
                    alert(data.message || 'تم إرسال البلاغ بنجاح.');
                    closeReportModal();
                    window.location.reload();
                } else {
                    alert(data.error || 'حدث خطأ أثناء إرسال البلاغ.');
                }
            } catch (err) {
                console.error('Report submission error:', err);
                alert('تعذر الاتصال بالسيرفر.');
            }
        }

        // --- نظام الإعجابات الفوري (AJAX Likes) ---
        async function toggleLike(targetType, targetId, btnElement) {
            try {
                const response = await fetch('/like', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ target_type: targetType, target_id: targetId })
                });
                const data = await response.json();
                if (data.success) {
                    const countSpan = btnElement.querySelector('.like-count');
                    countSpan.textContent = data.likesCount;
                    if (data.liked) {
                        btnElement.classList.add('liked');
                    } else {
                        btnElement.classList.remove('liked');
                    }
                }
            } catch (err) {
                console.error('Like error:', err);
            }
        }

        // --- نشر المنشورات بدون ريفرش (AJAX Posts) ---
        document.getElementById('createPostForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const formData = new FormData(this);

            try {
                const response = await fetch('/posts', {
                    method: 'POST',
                    body: formData,
                    headers: { 'Accept': 'application/json' }
                });
                const data = await response.json();

                if (data.success) {
                    this.reset();
                    const noMsg = document.getElementById('noPostsMsg');
                    if (noMsg) noMsg.remove();

                    const post = data.post;
                    let mediaHtml = '';
                    if (post.file_path) {
                        if (post.media_status === 'pending') {
                            mediaHtml = `<div style="background: #fffbeb; color: #b45309; padding: 0.85rem; border-radius: 10px; font-size: 0.88rem; border: 1px dashed #fcd34d; font-weight: 600;">⏳ الصورة قيد مراجعة الإدارة وسوف تظهر للجميع فور اعتمادها.</div>`;
                        } else if (post.file_type === 'image') {
                            mediaHtml = `<img src="${post.file_path}" alt="صورة مرفقة" loading="lazy">`;
                        } else if (post.file_type === 'pdf') {
                            mediaHtml = `<a href="${post.file_path}" target="_blank" class="pdf-box">📄 فتح ملف PDF المرفق</a>`;
                        }
                    }

                    const newPostHTML = `
                        <div class="card" data-post-id="${post.id}">
                            <div class="post-meta">
                                <div class="author-box">
                                    <span class="author">${post.display_name}</span>
                                    ${post.role === 'admin' ? '<span class="role-tag">إدارة المعهد</span>' : ''}
                                </div>
                                <div class="meta-left">
                                    <span class="date">الآن</span>
                                    <button class="btn-report" onclick="openReportModal('post', ${post.id})">🚨 إبلاغ</button>
                                </div>
                            </div>
                            ${post.content ? `<div class="post-body">${post.content}</div>` : ''}
                            <div class="media-preview">${mediaHtml}</div>
                            <div class="post-actions-bar">
                                <button class="btn-like" onclick="toggleLike('post', ${post.id}, this)">
                                    ❤️ <span class="like-count">0</span> إعجاب
                                </button>
                            </div>
                            <div class="comments">
                                <div class="comments-list"></div>
                                <form class="comment-form" onsubmit="submitComment(event, ${post.id})">
                                    <input type="text" name="content" placeholder="اكتب تعليقاً..." required>
                                    <button type="submit">تعليق</button>
                                </form>
                            </div>
                        </div>
                    `;
                    document.getElementById('postsContainer').insertAdjacentHTML('afterbegin', newPostHTML);
                }
            } catch (err) {
                console.error('Post creation error:', err);
            }
        });

        // --- إضافة التعليقات بدون ريفرش (AJAX Comments) ---
        async function submitComment(event, postId) {
            event.preventDefault();
            const form = event.target;
            const input = form.querySelector('input[name="content"]');
            const content = input.value.trim();
            if (!content) return;

            try {
                const response = await fetch(`/posts/${postId}/comments`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ content })
                });
                const data = await response.json();

                if (data.success) {
                    input.value = '';
                    const comment = data.comment;
                    const commentHTML = `
                        <div class="comment-item" data-comment-id="${comment.id}">
                            <div class="comment-content">
                                <b>${comment.display_name}:</b> ${comment.content}
                                <div class="comment-footer">
                                    <span style="font-size: 0.72rem; color: #94a3b8; font-weight: 600;">(الآن)</span>
                                    <button class="btn-like" style="font-size:0.75rem; padding:2px 6px;" onclick="toggleLike('comment', ${comment.id}, this)">
                                        ❤️ <span class="like-count">0</span>
                                    </button>
                                </div>
                            </div>
                            <button class="btn-report" onclick="openReportModal('comment', ${comment.id})">🚨 إبلاغ</button>
                        </div>
                    `;
                    const postCard = form.closest('.card');
                    postCard.querySelector('.comments-list').insertAdjacentHTML('beforeend', commentHTML);
                }
            } catch (err) {
                console.error('Comment error:', err);
            }
        }
    </script>
</body>
</html>
